@article{leeRLAIFScalingReinforcement2023,
  title = {{{RLAIF}}: {{Scaling Reinforcement Learning}} from {{Human Feedback}} with {{AI Feedback}}},
  shorttitle = {{{RLAIF}}},
  author = {Lee, Harrison and Phatale, Samrat and Mansoor, Hassan and Lu, Kellie Ren and Mesnard, Thomas and Ferret, Johan and Bishop, Colton and Hall, Ethan and Carbune, Victor and Rastogi, Abhinav},
  year = 2023,
  month = oct,
  urldate = {2026-11-24},
  abstract = {Reinforcement learning from human feedback (RLHF) is an effective technique for aligning large language models (LLMs) to human preferences, but gathering high-quality human preference labels is a critical bottleneck. RL from AI Feedback (RLAIF) is an alternative solution that generates preferences labels using an off-the-shelf LLM in lieu of human annotators. We compare RLAIF and RLHF, and we find that RLAIF achieves improvements on par with RLHF, with both RL policies outperforming the baseline supervised fine-tuning policy by approximately 70\textbackslash\% for summarization and 60\textbackslash\% for helpful dialogue generation, as rated by human evaluators. Furthermore, when asked to rate RLAIF against RLHF in a head-to-head comparison, both are equally preferred. These results suggest that RLAIF can achieve human-level performance, offering a potential solution to the scalability limitations of RLHF.},
  langid = {english},
}

