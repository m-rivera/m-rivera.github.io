@book{doctorowReverseCentaursGuide2026,
  title = {The Reverse Centaur's Guide to Life after {{AI}}: How to Think about Artificial Intelligence - before It's Too Late},
  shorttitle = {The Reverse Centaur's Guide to Life after {{AI}}},
  author = {Doctorow, Cory},
  year = 2026,
  publisher = {Verso},
  address = {London New York},
  abstract = {As we enter the age of AI, we are in danger of being reduced to what Cory Doctorow dubs the 'reverse centaur'. With that term he conjures a human being conscripted as the assistant to a dominant machine. It could be a driver made to deliver nonstop, all day long; a warehouse worker packing shelves without bathroom or food breaks; or a programmer reviewing impossible amounts of AI-produced code.Don't fall for the hype! The billionaires managing the rise of AI are putting on a command performance for the bosses and investors, not for the ordinary people who might use the products. When this latest tech bubble bursts, will there be something useful for us in the wreckage?In The Reverse Centaur's Guide to Life After AI, Doctorow examines why we find ourselves in this mess and how we can get out of it. Life after AI should mean the tools work for us, not the other way around},
  isbn = {978-1-83674-588-4 978-1-83674-552-5},
  langid = {english}
}


